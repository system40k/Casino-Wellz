# Runtime mode
# demo: local/browser-backed demo behavior
# production: requires an authoritative HTTPS backend
VITE_RUNTIME_MODE=demo

# Production backend API, e.g. https://api.example.com
# Required when VITE_RUNTIME_MODE=production
VITE_API_URL=

# Keep false until authoritative auth, ledger, game settlement,
# payments, KYC/AML, limits, and operational controls are complete.
VITE_REAL_MONEY_ENABLED=false

# Phase 2 server-side authentication
# These values are server secrets/configuration. Never prefix service-role keys with VITE_.
AUTH_ALLOWED_ORIGIN=https://casino.example
AUTH_SUPABASE_URL=https://your-auth-project.supabase.co
AUTH_SUPABASE_SERVICE_ROLE_KEY=
AUTH_EVM_RPC_URL=https://your-trusted-evm-rpc.example
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=900

# Bitcoin Configuration
# Demo/display value only. Production deposit attribution and settlement
# must be performed by the backend rather than trusted from browser code.
VITE_BTC_DEPOSIT_ADDRESS=bc1qyz5d4e8w5p8n7q6r8s9t0u1v2w3x4y5z6a7b8c

# Network Configuration
VITE_BTC_NETWORK=mainnet

# Optional: Custom Mempool API endpoint
# VITE_MEMPOOL_API_URL=https://mempool.space/api
